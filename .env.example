SECRET_KEY=change-me
SITE_URL=https://chargedalpha.com

# Add these Authorized redirect URIs to the Google OAuth web client:
# https://chargedalpha.com/auth/google/callback
# http://127.0.0.1:5001/auth/google/callback
#
# Add these Authorized JavaScript origins:
# https://chargedalpha.com
# http://127.0.0.1:5001
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

# Optional override if a deployment needs an exact callback URL.
GOOGLE_REDIRECT_URI=
